{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Toolkit object v0 (draft)",
  "type": "object",
  "required": [
    "schema",
    "id",
    "identity",
    "viewBox",
    "regions",
    "ports",
    "anchors",
    "states",
    "generator"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "vt.object/v0"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "identity": {
      "type": "object",
      "required": [
        "family",
        "kind",
        "category",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "$ref": "#/$defs/slug"
        },
        "category": {
          "enum": [
            "process-equipment",
            "valve",
            "instrument",
            "material-handling",
            "electrical"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "viewBox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "anchors": {
      "type": "object",
      "required": [
        "badge"
      ],
      "additionalProperties": false,
      "properties": {
        "badge": {
          "$ref": "#/$defs/point"
        },
        "label": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/state"
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/animation"
      }
    },
    "label": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 24
        }
      }
    },
    "spatial": {
      "type": "object",
      "required": [
        "format",
        "uri"
      ],
      "properties": {
        "format": {
          "enum": [
            "gltf",
            "glb"
          ]
        },
        "uri": {
          "type": "string"
        },
        "regionMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "required": [
        "id",
        "version",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "params": {
          "$ref": "#/$defs/params"
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "state": {
      "enum": [
        "normal",
        "running",
        "warning",
        "fault",
        "maintenance",
        "disabled",
        "comm-loss"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "role",
        "paint",
        "shapes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "role": {
          "enum": [
            "body",
            "body-secondary",
            "nozzle",
            "flange",
            "base",
            "detail",
            "rotor",
            "indicator",
            "fill",
            "product"
          ]
        },
        "label": {
          "type": "string"
        },
        "paint": {
          "enum": [
            "solid",
            "line"
          ]
        },
        "shapes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shape"
          }
        },
        "clip": {
          "$ref": "#/$defs/shape"
        },
        "level": {
          "type": "object",
          "required": [
            "value",
            "bottom"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bottom": {
              "type": "number"
            }
          }
        }
      }
    },
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "d"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "path"
            },
            "d": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "rect"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            },
            "rx": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "cx",
            "cy",
            "r"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "circle"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "r": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "cx",
            "cy",
            "rx",
            "ry"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "ellipse"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "rx": {
              "type": "number",
              "minimum": 0
            },
            "ry": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "x1",
            "y1",
            "x2",
            "y2"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "line"
            },
            "x1": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y2": {
              "type": "number"
            }
          }
        }
      ]
    },
    "port": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "x",
        "y",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "inlet",
            "outlet",
            "bidirectional",
            "signal",
            "power",
            "mechanical"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "direction": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "size": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "animation": {
      "type": "object",
      "required": [
        "id",
        "type",
        "region",
        "states",
        "periodMs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "type": {
          "enum": [
            "rotate",
            "flow",
            "turn"
          ]
        },
        "region": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "periodMs": {
          "type": "number",
          "minimum": 50
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "vector": {
          "$ref": "#/$defs/point"
        }
      }
    }
  }
}
